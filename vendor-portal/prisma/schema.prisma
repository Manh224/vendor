  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  resolver User?    @relation("KpiDisputeResolver", fields: [resolvedBy], references: [id])
  creator  User?    @relation("KpiDisputeCreator", fields: [createdBy], references: [id])

