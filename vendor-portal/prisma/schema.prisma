}

model KpiScore {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  period      String   @db.VarChar(20)
  periodType  String   @map("period_type") @db.VarChar(20)
  totalScore  Decimal? @map("total_score") @db.Decimal(5, 2)
