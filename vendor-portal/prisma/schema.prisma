// Prisma Schema for Vendor Portal
// Database: Vendor_portal (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MODULE 7: SYSTEM ADMIN
// ============================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(200)
  side        String   @db.VarChar(20) // 'supermarket' | 'vendor'
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  resource    String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@unique([module, action, resource])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(200)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.Text

  // Role & Access
  roleId   String  @map("role_id") @db.Uuid
  vendorId String? @map("vendor_id") @db.Uuid
  side     String  @db.VarChar(20) // 'supermarket' | 'vendor'

  // Security
  isActive          Boolean   @default(true) @map("is_active")
  is2faEnabled      Boolean   @default(false) @map("is_2fa_enabled")
  twoFaSecret       String?   @map("two_fa_secret") @db.VarChar(255)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp       String?   @map("last_login_ip") @db.VarChar(45)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  inactiveSince     DateTime? @map("inactive_since") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  role   Role    @relation(fields: [roleId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  // Reverse relations
  auditLogs              AuditLog[]
  vendorDocumentsReviewed VendorDocument[] @relation("DocumentReviewer")
  contractsChangedStatus  Contract[]       @relation("ContractStatusChanger")
  contractsCreated        Contract[]       @relation("ContractCreator")
  productsApproved        Product[]        @relation("ProductApprover")
  productsCreated         Product[]        @relation("ProductCreator")
  priceChangeReviews      PriceChangeRequest[] @relation("PriceChangeReviewer")
  priceChangeCreated      PriceChangeRequest[] @relation("PriceChangeCreator")
  promotionsReviewed      Promotion[]      @relation("PromotionReviewer")
  promotionsCreated       Promotion[]      @relation("PromotionCreator")
  purchaseOrdersCreated   PurchaseOrder[]  @relation("POCreator")
  asnApproved             AdvanceShippingNotice[] @relation("ASNApprover")
  asnCreated              AdvanceShippingNotice[] @relation("ASNCreator")
  goodsReceived           GoodsReceipt[]   @relation("GoodsReceiver")
  invoicesCreated         Invoice[]        @relation("InvoiceCreator")
  reconciliationsResolved Reconciliation[] @relation("ReconciliationResolver")
  debitNotesCreated       DebitNote[]      @relation("DebitNoteCreator")
  kpiScoresReviewed       KpiScore[]       @relation("KpiReviewer")
  kpiDisputesResolved     KpiDispute[]     @relation("KpiDisputeResolver")
  kpiDisputesCreated      KpiDispute[]     @relation("KpiDisputeCreator")
  kpiScoreAdjustments     KpiScoreDetail[] @relation("KpiAdjuster")
  vendorRankingsCreated   VendorRanking[]  @relation("RankingCreator")
  announcementsCreated    Announcement[]   @relation("AnnouncementCreator")
  ticketsAssigned         Ticket[]         @relation("TicketAssignee")
  ticketsCreated          Ticket[]         @relation("TicketCreator")
  ticketMessages          TicketMessage[]
  ticketRatings           TicketRating[]
  notifications           Notification[]
  fileAttachments         FileAttachment[]
  vendorsCreated          Vendor[]         @relation("VendorCreator")
  vendorStatusChanges     Vendor[]         @relation("VendorStatusChanger")

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(50)
  module      String?  @db.VarChar(50)
  resource    String?  @db.VarChar(100)
  resourceId  String?  @map("resource_id") @db.Uuid
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ============================================================================
// MODULE 1: VENDOR MANAGEMENT
// ============================================================================

model Vendor {
  id          String  @id @default(uuid()) @db.Uuid
  companyName String  @map("company_name") @db.VarChar(300)
  taxCode     String  @unique @map("tax_code") @db.VarChar(20)
  address     String? @db.Text
  city        String? @db.VarChar(100)
  district    String? @db.VarChar(100)
  ward        String? @db.VarChar(100)
  phone       String? @db.VarChar(20)
  email       String? @db.VarChar(255)
  website     String? @db.VarChar(500)

  // Bank info
  bankName        String? @map("bank_name") @db.VarChar(200)
  bankBranch      String? @map("bank_branch") @db.VarChar(200)
  bankAccountNo   String? @map("bank_account_no") @db.VarChar(50)
  bankAccountName String? @map("bank_account_name") @db.VarChar(200)

  // Status
  status          String    @default("pending_registration") @db.VarChar(30)
  statusChangedAt DateTime? @map("status_changed_at") @db.Timestamptz
  statusChangedBy String?   @map("status_changed_by") @db.Uuid
  statusNotes     String?   @map("status_notes") @db.Text

  // Ranking
  currentRanking String @default("N/A") @map("current_ranking") @db.VarChar(5)

  // ERP
  erpVendorId    String?   @map("erp_vendor_id") @db.VarChar(50)
  erpSyncStatus  String    @default("not_synced") @map("erp_sync_status") @db.VarChar(20)
  erpLastSyncedAt DateTime? @map("erp_last_synced_at") @db.Timestamptz

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  createdByUser       User? @relation("VendorCreator", fields: [createdBy], references: [id])
  statusChangedByUser User? @relation("VendorStatusChanger", fields: [statusChangedBy], references: [id])

  // Relations
  users               User[]
  contacts            VendorContact[]
  documents           VendorDocument[]
  contracts           Contract[]
  products            Product[]
  purchaseOrders      PurchaseOrder[]
  asns                AdvanceShippingNotice[]
  goodsReceipts       GoodsReceipt[]
  invoices            Invoice[]
  reconciliations     Reconciliation[]
  debitNotes          DebitNote[]
  consignmentSales    ConsignmentSale[]
  kpiScores           KpiScore[]
  kpiDisputes         KpiDispute[]
  vendorRankings      VendorRanking[]
  tickets             Ticket[]
  announcementRecipients AnnouncementRecipient[]
  priceChangeRequests PriceChangeRequest[]
  promotions          Promotion[]

  @@map("vendors")
}

model VendorContact {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(200)
  position  String?  @db.VarChar(100)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_contacts")
}

model VendorDocumentType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  code        String   @unique @db.VarChar(50)
  isRequired  Boolean  @default(false) @map("is_required")
  hasExpiry   Boolean  @default(true) @map("has_expiry")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  documents VendorDocument[]

  @@map("vendor_document_types")
}

model VendorDocument {
  id             String   @id @default(uuid()) @db.Uuid
  vendorId       String   @map("vendor_id") @db.Uuid
  documentTypeId String   @map("document_type_id") @db.Uuid
  documentNumber String?  @map("document_number") @db.VarChar(100)
  fileUrl        String   @map("file_url") @db.Text
  fileName       String?  @map("file_name") @db.VarChar(500)
  issuedDate     DateTime? @map("issued_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date

  // Alert
  alertDays      Int[]    @default([60, 30, 15]) @map("alert_days")
  lastAlertSentAt DateTime? @map("last_alert_sent_at") @db.Timestamptz
  isExpired      Boolean  @default(false) @map("is_expired")

  // Review
  status      String    @default("pending") @db.VarChar(20)
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes String?   @map("review_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor       Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentType VendorDocumentType @relation(fields: [documentTypeId], references: [id])
  reviewer     User?              @relation("DocumentReviewer", fields: [reviewedBy], references: [id])

  @@map("vendor_documents")
}

model Contract {
  id               String    @id @default(uuid()) @db.Uuid
  vendorId         String    @map("vendor_id") @db.Uuid
  contractNumber   String    @map("contract_number") @db.VarChar(100)
  contractType     String    @map("contract_type") @db.VarChar(30) // 'principal' | 'appendix'
  parentContractId String?   @map("parent_contract_id") @db.Uuid
  title            String?   @db.VarChar(500)
  fileUrl          String?   @map("file_url") @db.Text
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime  @map("end_date") @db.Date

  // Alert
  alertDays        Int[]     @default([90, 60, 30]) @map("alert_days")
  lastAlertSentAt  DateTime? @map("last_alert_sent_at") @db.Timestamptz

  // Contract terms (merged)
  paymentTermsDays    Int       @default(30) @map("payment_terms_days")
  discountRate        Decimal   @default(0) @map("discount_rate") @db.Decimal(5, 2)
  salesBonusTarget    Decimal?  @map("sales_bonus_target") @db.Decimal(18, 2)
  salesBonusRate      Decimal?  @map("sales_bonus_rate") @db.Decimal(5, 2)
  displayFee          Decimal   @default(0) @map("display_fee") @db.Decimal(18, 2)
  marketingSupportFee Decimal   @default(0) @map("marketing_support_fee") @db.Decimal(18, 2)
  penaltyTerms        String?   @map("penalty_terms") @db.Text
  otherTerms          Json?     @map("other_terms")

  // Status
  status            String    @default("draft") @db.VarChar(20)
  statusChangedAt   DateTime? @map("status_changed_at") @db.Timestamptz
  statusChangedBy   String?   @map("status_changed_by") @db.Uuid
  statusNotes       String?   @map("status_notes") @db.Text

  // Signature
  signedByVendor      Boolean   @default(false) @map("signed_by_vendor")
  signedBySupermarket Boolean   @default(false) @map("signed_by_supermarket")
  signedAt            DateTime? @map("signed_at") @db.Timestamptz

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  vendor            Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  parentContract    Contract?  @relation("ContractHierarchy", fields: [parentContractId], references: [id])
  childContracts    Contract[] @relation("ContractHierarchy")
  statusChanger     User?      @relation("ContractStatusChanger", fields: [statusChangedBy], references: [id])
  creator           User?      @relation("ContractCreator", fields: [createdBy], references: [id])
  debitNotes        DebitNote[]

  @@index([vendorId])
  @@index([endDate])
  @@map("contracts")
}

// ============================================================================
// MODULE 2: PRODUCT & PRICING
// ============================================================================

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(50)
  parentId  String?  @map("parent_id") @db.Uuid
  level     Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@map("product_categories")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  vendorId    String  @map("vendor_id") @db.Uuid
  categoryId  String? @map("category_id") @db.Uuid
  sku         String? @unique @db.VarChar(50)
  name        String  @db.VarChar(500)
  description String? @db.Text

  // Barcodes & Images (JSONB)
  barcodes Json @default("[]")
  images   Json @default("[]")

  // Specs
  unit         String?  @db.VarChar(50)
  packSize     String?  @map("pack_size") @db.VarChar(100)
  weight       Decimal? @db.Decimal(10, 3)
  dimensions   String?  @db.VarChar(100)
  shelfLifeDays Int?    @map("shelf_life_days")
  minRemainingShelfLife Int? @map("min_remaining_shelf_life")

  // Price
  currentPrice Decimal? @map("current_price") @db.Decimal(18, 2)
  currency     String   @default("VND") @db.VarChar(3)

  // Min stock
  minStockLevel Int? @map("min_stock_level")

  // Certifications
  certifications Json @default("[]")

  // Status
  status     String    @default("draft") @db.VarChar(20)
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz

  // ERP
  erpItemId     String? @map("erp_item_id") @db.VarChar(50)
  erpSyncStatus String  @default("not_synced") @map("erp_sync_status") @db.VarChar(20)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  vendor    Vendor           @relation(fields: [vendorId], references: [id])
  category  ProductCategory? @relation(fields: [categoryId], references: [id])
  approver  User?            @relation("ProductApprover", fields: [approvedBy], references: [id])
  creator   User?            @relation("ProductCreator", fields: [createdBy], references: [id])

  priceChangeRequests PriceChangeRequest[]
  purchaseOrderItems  PurchaseOrderItem[]
  invoiceItems        InvoiceItem[]
  consignmentSales    ConsignmentSale[]

  @@index([vendorId])
  @@index([sku])
  @@map("products")
}

model PriceChangeRequest {
  id             String   @id @default(uuid()) @db.Uuid
  vendorId       String   @map("vendor_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  currentPrice   Decimal  @map("current_price") @db.Decimal(18, 2)
  proposedPrice  Decimal  @map("proposed_price") @db.Decimal(18, 2)
  priceChangePct Decimal? @map("price_change_pct") @db.Decimal(5, 2)
  reason         String   @db.Text
  effectiveDate  DateTime @map("effective_date") @db.Date
  appendixFileUrl String? @map("appendix_file_url") @db.Text
  status         String   @default("pending") @db.VarChar(20)
  reviewedBy     String?  @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes    String?  @map("review_notes") @db.Text
  finalPrice     Decimal? @map("final_price") @db.Decimal(18, 2)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor   Vendor  @relation(fields: [vendorId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  reviewer User?   @relation("PriceChangeReviewer", fields: [reviewedBy], references: [id])
  creator  User?   @relation("PriceChangeCreator", fields: [createdBy], references: [id])

  @@map("price_change_requests")
}

model Promotion {
  id             String   @id @default(uuid()) @db.Uuid
  vendorId       String   @map("vendor_id") @db.Uuid
  title          String   @db.VarChar(500)
  promotionType  String   @map("promotion_type") @db.VarChar(30)
  description    String?  @db.Text
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  productIds     String[] @map("product_ids") @db.Uuid
  discountValue  Decimal? @map("discount_value") @db.Decimal(18, 2)
  promoPrice     Decimal? @map("promo_price") @db.Decimal(18, 2)
  estimatedQty   Int?     @map("estimated_qty")
  committedStock Int?     @map("committed_stock")
  giftDescription String? @map("gift_description") @db.Text
  status         String   @default("pending") @db.VarChar(20)
  reviewedBy     String?  @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes    String?  @map("review_notes") @db.Text
  erpPromoId     String?  @map("erp_promo_id") @db.VarChar(50)
  erpSyncStatus  String   @default("not_synced") @map("erp_sync_status") @db.VarChar(20)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor   Vendor @relation(fields: [vendorId], references: [id])
  reviewer User?  @relation("PromotionReviewer", fields: [reviewedBy], references: [id])
  creator  User?  @relation("PromotionCreator", fields: [createdBy], references: [id])

  @@index([startDate, endDate])
  @@map("promotions")
}

// ============================================================================
// MODULE 3: PURCHASE ORDERS
// ============================================================================

model PurchaseOrder {
  id              String   @id @default(uuid()) @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  poNumber        String   @unique @map("po_number") @db.VarChar(50)
  isReturnOrder   Boolean  @default(false) @map("is_return_order")
  returnReason    String?  @map("return_reason") @db.Text
  orderDate       DateTime @default(now()) @map("order_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  deliveryLocation String? @map("delivery_location") @db.VarChar(500)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency        String   @default("VND") @db.VarChar(3)
  status          String   @default("new") @db.VarChar(30)

  // Vendor response
  vendorResponse      String?   @map("vendor_response") @db.VarChar(20)
  vendorResponseAt    DateTime? @map("vendor_response_at") @db.Timestamptz
  vendorResponseNotes String?   @map("vendor_response_notes") @db.Text
  vendorProposedQty   Json?     @map("vendor_proposed_qty")
  vendorProposedDate  DateTime? @map("vendor_proposed_date") @db.Date
  responseDeadline    DateTime? @map("response_deadline") @db.Timestamptz

  // ERP
  erpPoId        String?   @map("erp_po_id") @db.VarChar(50)
  erpSyncStatus  String    @default("not_synced") @map("erp_sync_status") @db.VarChar(20)
  erpLastSyncedAt DateTime? @map("erp_last_synced_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor  Vendor @relation(fields: [vendorId], references: [id])
  creator User?  @relation("POCreator", fields: [createdBy], references: [id])

  items         PurchaseOrderItem[]
  asns          AdvanceShippingNotice[]
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]
  debitNotes    DebitNote[]

  @@index([vendorId])
  @@index([status])
  @@index([isReturnOrder])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  orderedQty      Int     @map("ordered_qty")
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(18, 2)

  // Actual received (merged from goods_receipt_items)
  actualReceivedQty Int @default(0) @map("actual_received_qty")
  damagedQty        Int @default(0) @map("damaged_qty")
  shortageQty       Int @default(0) @map("shortage_qty")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  invoiceItems  InvoiceItem[]

  @@map("purchase_order_items")
}

model AdvanceShippingNotice {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  asnNumber       String   @unique @map("asn_number") @db.VarChar(50)
  asnBarcode      String?  @map("asn_barcode") @db.VarChar(100)
  items           Json     // JSONB array of items
  carrierName     String?  @map("carrier_name") @db.VarChar(200)
  vehiclePlate    String?  @map("vehicle_plate") @db.VarChar(20)
  driverName      String?  @map("driver_name") @db.VarChar(200)
