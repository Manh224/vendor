model Announcement {
  id              String    @id @default(uuid()) @db.Uuid
  title           String    @db.VarChar(500)
  content         String    @db.Text
  attachments     Json      @default("[]")
  targetType      String    @map("target_type") @db.VarChar(20)
  targetCategoryIds String[] @map("target_category_ids") @db.Uuid
  targetVendorIds String[]  @map("target_vendor_ids") @db.Uuid
  publishAt       DateTime  @default(now()) @map("publish_at") @db.Timestamptz
  expireAt        DateTime? @map("expire_at") @db.Timestamptz
  isImportant     Boolean   @default(false) @map("is_important")
  status          String    @default("draft") @db.VarChar(20)
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

