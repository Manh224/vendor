  @@unique([ticketCategory, priority])
  @@map("sla_configs")
}

model Ticket {
  id                 String    @id @default(uuid()) @db.Uuid
  vendorId           String    @map("vendor_id") @db.Uuid
  ticketNumber       String    @unique @map("ticket_number") @db.VarChar(50)
  category           String    @db.VarChar(50)
  priority           String    @default("medium") @db.VarChar(20)
  title              String    @db.VarChar(500)
  description        String    @db.Text
  attachments        Json      @default("[]")
  referenceType      String?   @map("reference_type") @db.VarChar(50)
  referenceId        String?   @map("reference_id") @db.Uuid
  status             String    @default("new") @db.VarChar(20)
  assignedTo         String?   @map("assigned_to") @db.Uuid
  assignedDepartment String?   @map("assigned_department") @db.VarChar(100)
  assignedAt         DateTime? @map("assigned_at") @db.Timestamptz
  slaConfigId        String?   @map("sla_config_id") @db.Uuid
  slaDeadline        DateTime? @map("sla_deadline") @db.Timestamptz
  slaStatus          String    @default("on_track") @map("sla_status") @db.VarChar(20)
  slaPausedAt        DateTime? @map("sla_paused_at") @db.Timestamptz
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz
  resolutionNotes    String?   @map("resolution_notes") @db.Text
  autoCloseAt        DateTime? @map("auto_close_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor    Vendor     @relation(fields: [vendorId], references: [id])
