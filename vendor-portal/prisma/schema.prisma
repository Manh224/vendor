  kpiScore      KpiScore      @relation(fields: [kpiScoreId], references: [id], onDelete: Cascade)
  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])
  adjuster      User?         @relation("KpiAdjuster", fields: [adjustedBy], references: [id])

  @@map("kpi_score_details")
}

model KpiDispute {
  id                 String   @id @default(uuid()) @db.Uuid
  kpiScoreId         String   @map("kpi_score_id") @db.Uuid
  vendorId           String   @map("vendor_id") @db.Uuid
  disputedResource   String?  @map("disputed_resource") @db.VarChar(100)
  disputedResourceId String?  @map("disputed_resource_id") @db.Uuid
  reason             String   @db.Text
