  reviewedBy  String?  @map("reviewed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor   Vendor @relation(fields: [vendorId], references: [id])
  reviewer User?  @relation("KpiReviewer", fields: [reviewedBy], references: [id])

  details  KpiScoreDetail[]
  disputes KpiDispute[]

  @@unique([vendorId, period, periodType])
  @@index([vendorId])
  @@index([period])
  @@map("kpi_scores")
}

model KpiScoreDetail {
  id              String   @id @default(uuid()) @db.Uuid
  kpiScoreId      String   @map("kpi_score_id") @db.Uuid
  kpiDefinitionId String   @map("kpi_definition_id") @db.Uuid
