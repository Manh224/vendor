model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  invoiceNumber   String   @map("invoice_number") @db.VarChar(50)
  invoiceSymbol   String?  @map("invoice_symbol") @db.VarChar(20)
  invoiceDate     DateTime @map("invoice_date") @db.Date
  xmlFileUrl      String?  @map("xml_file_url") @db.Text
  pdfFileUrl      String?  @map("pdf_file_url") @db.Text
  subtotal        Decimal  @db.Decimal(18, 2)
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(18, 2)
  currency        String   @default("VND") @db.VarChar(3)
  grnIds          String[] @map("grn_ids") @db.Uuid
  reconciliationStatus String @default("pending") @map("reconciliation_status") @db.VarChar(20)

  // Payment (merged from payments table)
  paymentStatus    String    @default("unpaid") @map("payment_status") @db.VarChar(20)
  paymentDueDate   DateTime? @map("payment_due_date") @db.Date
  paymentDate      DateTime? @map("payment_date") @db.Timestamptz
  paymentAmount    Decimal?  @map("payment_amount") @db.Decimal(18, 2)
  paymentReference String?   @map("payment_reference") @db.VarChar(100)
  paymentProofUrl  String?   @map("payment_proof_url") @db.Text
  paymentMethod    String?   @map("payment_method") @db.VarChar(30)
  paymentNotes     String?   @map("payment_notes") @db.Text

  status          String   @default("draft") @db.VarChar(20)
  validationErrors Json?   @map("validation_errors")
  erpInvoiceId    String?  @map("erp_invoice_id") @db.VarChar(50)
  erpSyncStatus   String   @default("not_synced") @map("erp_sync_status") @db.VarChar(20)
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  creator       User?          @relation("InvoiceCreator", fields: [createdBy], references: [id])

  items           InvoiceItem[]
  reconciliations Reconciliation[]
  debitNotes      DebitNote[]

  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([paymentStatus])
  @@index([paymentDueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  poItemId    String? @map("po_item_id") @db.Uuid
  description String? @db.VarChar(500)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?           @relation(fields: [productId], references: [id])
  poItem  PurchaseOrderItem? @relation(fields: [poItemId], references: [id])

  @@map("invoice_items")
}

model Reconciliation {
  id                 String   @id @default(uuid()) @db.Uuid
  invoiceId          String   @map("invoice_id") @db.Uuid
  vendorId           String   @map("vendor_id") @db.Uuid
  period             String?  @db.VarChar(20)
  poTotal            Decimal? @map("po_total") @db.Decimal(18, 2)
  grnTotal           Decimal? @map("grn_total") @db.Decimal(18, 2)
  invoiceTotal       Decimal? @map("invoice_total") @db.Decimal(18, 2)
  matchStatus        String   @map("match_status") @db.VarChar(20)
  discrepancyAmount  Decimal  @default(0) @map("discrepancy_amount") @db.Decimal(18, 2)
